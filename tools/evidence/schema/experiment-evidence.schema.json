{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eepistore.web.id/schema/experiment-evidence-1.0.0.json",
  "title": "Eepistore thesis experiment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "metadata",
    "provenance",
    "delivery",
    "security",
    "functional",
    "runtime",
    "monitoring",
    "conformance",
    "baseline",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["sample", "final", "stale", "failed", "incomplete"] },
    "metadata": {
      "type": "object",
      "required": ["experimentId", "region", "targetUrl", "startedAt", "endedAt"],
      "properties": {
        "experimentId": { "type": "string", "minLength": 6 },
        "region": { "type": "string" },
        "targetUrl": { "type": "string", "format": "uri" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["appCommit", "infraCommit", "imageDigest", "githubRunIds"],
      "properties": {
        "appCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "infraCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "githubRunIds": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "delivery": { "$ref": "#/$defs/section" },
    "security": { "$ref": "#/$defs/section" },
    "functional": { "$ref": "#/$defs/section" },
    "runtime": { "$ref": "#/$defs/section" },
    "monitoring": { "$ref": "#/$defs/section" },
    "conformance": { "$ref": "#/$defs/section" },
    "baseline": { "type": ["object", "null"] },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["status", "metrics"],
      "properties": {
        "status": { "enum": ["passed", "failed", "missing", "partial", "not-applicable"] },
        "metrics": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
