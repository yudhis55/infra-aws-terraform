{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::eepistore-dev-terraform-state",
        "arn:aws:s3:::eepistore-dev-terraform-state/eepistore/dev/*"
      ]
    },
    {
      "Sid": "DecryptTerraformState",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-3:557947229844:key/fd2250a6-ed79-4f87-8c18-1d6e14df8e84"
    },
    {
      "Sid": "InspectExperimentTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeContainerInstances",
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeTasks",
        "ecs:ListContainerInstances",
        "ecs:ListTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunOnlyEepistoreExperimentTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:ap-southeast-3:557947229844:task-definition/eepistore-task:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:ap-southeast-3:557947229844:cluster/eepistore-cluster"
        }
      }
    },
    {
      "Sid": "PassOnlyEepistoreTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::557947229844:role/eepistore-ecs-task-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadRuntimeTelemetry",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribeScalingActivities",
        "application-autoscaling:DescribeScalingActivities",
        "application-autoscaling:DescribeScalableTargets",
        "application-autoscaling:DescribeScalingPolicies",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeTargetHealth",
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:GetQueryResults",
        "logs:StartQuery",
        "logs:StopQuery",
        "rds:DescribeDBInstances",
        "rds:DescribeDBProxies",
        "rds:DescribeDBProxyTargets",
        "wafv2:GetWebACL",
        "wafv2:GetWebACLForResource",
        "wafv2:GetSampledRequests"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseOnlyApprovedRunShellDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ap-southeast-3::document/AWS-RunShellScript"
    },
    {
      "Sid": "RunCommandsOnlyOnTaggedAgent",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ap-southeast-3:557947229844:instance/*",
      "Condition": {
        "StringLike": {
          "ssm:resourceTag/ExperimentId": "campaign-*"
        }
      }
    },
    {
      "Sid": "ReadOnlyApprovedCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AssumeOnlyTemporaryDriftRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::557947229844:role/eepistore-experiment-drift-role"
    },
    {
      "Sid": "VerifyPublishedImageProvenance",
      "Effect": "Allow",
      "Action": "ecr:DescribeImages",
      "Resource": "arn:aws:ecr:ap-southeast-3:557947229844:repository/eepistore-repo"
    },
    {
      "Sid": "ReadExperimentBucketLocations",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::eepistore-dev-public-media-*",
        "arn:aws:s3:::eepistore-dev-private-documents-*"
      ]
    },
    {
      "Sid": "ListExperimentObjectPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::eepistore-dev-public-media-*",
        "arn:aws:s3:::eepistore-dev-private-documents-*"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "products/*",
            "payments/*"
          ]
        }
      }
    },
    {
      "Sid": "DeleteOnlyExperimentObjectClasses",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::eepistore-dev-public-media-*/products/*",
        "arn:aws:s3:::eepistore-dev-private-documents-*/payments/*"
      ]
    }
  ]
}
